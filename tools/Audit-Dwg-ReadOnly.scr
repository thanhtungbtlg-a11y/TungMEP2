_.AUDIT
_N
(vl-load-com)
(defun tm2-count (filter / selection) (if (setq selection (ssget "_X" filter)) (sslength selection) 0))
(setq tm2-block-entities 0 tm2-block-text 0 tm2-block-linework 0 tm2-block-viewports 0 tm2-block-inserts 0 tm2-block-hatches 0 tm2-block-dimensions 0 tm2-explicit-entity-lineweights 0 tm2-explicit-entity-linetypes 0 tm2-explicit-entity-colors 0 tm2-sheet-number-text 0)
(setq tm2-block-record (tblnext "BLOCK" T))
(while tm2-block-record (setq tm2-entity (cdr (assoc -2 tm2-block-record))) (while tm2-entity (setq tm2-data (entget tm2-entity)) (setq tm2-type (cdr (assoc 0 tm2-data))) (if (= tm2-type "ENDBLK") (setq tm2-entity nil) (progn (setq tm2-block-entities (1+ tm2-block-entities)) (if (member tm2-type '("TEXT" "MTEXT" "ATTRIB" "ATTDEF")) (progn (setq tm2-block-text (1+ tm2-block-text)) (setq tm2-text-value (cdr (assoc 1 tm2-data))) (if (and tm2-text-value (wcmatch (strcase tm2-text-value) "*FF-FP-*")) (setq tm2-sheet-number-text (1+ tm2-sheet-number-text))))) (if (member tm2-type '("LINE" "LWPOLYLINE" "POLYLINE" "ARC" "CIRCLE" "SPLINE" "ELLIPSE")) (setq tm2-block-linework (1+ tm2-block-linework))) (if (= tm2-type "VIEWPORT") (setq tm2-block-viewports (1+ tm2-block-viewports))) (if (= tm2-type "INSERT") (setq tm2-block-inserts (1+ tm2-block-inserts))) (if (= tm2-type "HATCH") (setq tm2-block-hatches (1+ tm2-block-hatches))) (if (= tm2-type "DIMENSION") (setq tm2-block-dimensions (1+ tm2-block-dimensions))) (setq tm2-lineweight (cdr (assoc 370 tm2-data))) (if (and tm2-lineweight (> tm2-lineweight 0)) (setq tm2-explicit-entity-lineweights (1+ tm2-explicit-entity-lineweights))) (setq tm2-linetype (cdr (assoc 6 tm2-data))) (if (and tm2-linetype (/= (strcase tm2-linetype) "BYLAYER")) (setq tm2-explicit-entity-linetypes (1+ tm2-explicit-entity-linetypes))) (setq tm2-color (cdr (assoc 62 tm2-data))) (if (and tm2-color (/= tm2-color 256)) (setq tm2-explicit-entity-colors (1+ tm2-explicit-entity-colors))) (setq tm2-entity (entnext tm2-entity))))) (setq tm2-block-record (tblnext "BLOCK")))
(princ "\nTM2_QC_BEGIN")
(princ (strcat "\nTM2_QC_CURRENT_LAYOUT=" (getvar "CTAB")))
(princ (strcat "\nTM2_QC_MODEL_ENTITIES=" (itoa (tm2-count '((410 . "Model"))))))
(princ (strcat "\nTM2_QC_PAPER_ENTITIES=" (itoa (tm2-count '((-4 . "<NOT") (410 . "Model") (-4 . "NOT>"))))))
(princ (strcat "\nTM2_QC_PAPER_TEXT=" (itoa (tm2-count '((-4 . "<AND") (-4 . "<NOT") (410 . "Model") (-4 . "NOT>") (0 . "TEXT,MTEXT,ATTRIB,ATTDEF") (-4 . "AND>"))))))
(princ (strcat "\nTM2_QC_PAPER_LINEWORK=" (itoa (tm2-count '((-4 . "<AND") (-4 . "<NOT") (410 . "Model") (-4 . "NOT>") (0 . "LINE,LWPOLYLINE,POLYLINE,ARC,CIRCLE,SPLINE,ELLIPSE") (-4 . "AND>"))))))
(princ (strcat "\nTM2_QC_PAPER_VIEWPORTS=" (itoa (tm2-count '((-4 . "<AND") (-4 . "<NOT") (410 . "Model") (-4 . "NOT>") (0 . "VIEWPORT") (-4 . "AND>"))))))
(princ (strcat "\nTM2_QC_PAPER_INSERTS=" (itoa (tm2-count '((-4 . "<AND") (-4 . "<NOT") (410 . "Model") (-4 . "NOT>") (0 . "INSERT") (-4 . "AND>"))))))
(princ (strcat "\nTM2_QC_ALL_INSERTS=" (itoa (tm2-count '((0 . "INSERT"))))))
(princ (strcat "\nTM2_QC_BLOCK_ENTITIES=" (itoa tm2-block-entities)))
(princ (strcat "\nTM2_QC_BLOCK_TEXT=" (itoa tm2-block-text)))
(princ (strcat "\nTM2_QC_BLOCK_LINEWORK=" (itoa tm2-block-linework)))
(princ (strcat "\nTM2_QC_BLOCK_VIEWPORTS=" (itoa tm2-block-viewports)))
(princ (strcat "\nTM2_QC_BLOCK_INSERTS=" (itoa tm2-block-inserts)))
(princ (strcat "\nTM2_QC_BLOCK_HATCHES=" (itoa tm2-block-hatches)))
(princ (strcat "\nTM2_QC_BLOCK_DIMENSIONS=" (itoa tm2-block-dimensions)))
(princ (strcat "\nTM2_QC_SHEET_NUMBER_TEXT=" (itoa tm2-sheet-number-text)))
(princ (strcat "\nTM2_QC_EXPLICIT_ENTITY_LINEWEIGHTS=" (itoa tm2-explicit-entity-lineweights)))
(princ (strcat "\nTM2_QC_EXPLICIT_ENTITY_LINETYPES=" (itoa tm2-explicit-entity-linetypes)))
(princ (strcat "\nTM2_QC_EXPLICIT_ENTITY_COLORS=" (itoa tm2-explicit-entity-colors)))
(setq tm2-layer-count 0 tm2-noncontinuous-layers 0 tm2-explicit-lineweight-layers 0 tm2-record (tblnext "LAYER" T))
(while tm2-record (setq tm2-layer-count (1+ tm2-layer-count)) (setq tm2-layer-linetype (cdr (assoc 6 tm2-record))) (if (and tm2-layer-linetype (/= (strcase tm2-layer-linetype) "CONTINUOUS")) (setq tm2-noncontinuous-layers (1+ tm2-noncontinuous-layers))) (setq tm2-layer-lineweight (cdr (assoc 370 tm2-record))) (if (and tm2-layer-lineweight (> tm2-layer-lineweight 0)) (setq tm2-explicit-lineweight-layers (1+ tm2-explicit-lineweight-layers))) (setq tm2-record (tblnext "LAYER")))
(princ (strcat "\nTM2_QC_LAYERS=" (itoa tm2-layer-count)))
(princ (strcat "\nTM2_QC_NONCONTINUOUS_LAYERS=" (itoa tm2-noncontinuous-layers)))
(princ (strcat "\nTM2_QC_EXPLICIT_LINEWEIGHT_LAYERS=" (itoa tm2-explicit-lineweight-layers)))
(setq tm2-linetype-count 0 tm2-record (tblnext "LTYPE" T))
(while tm2-record (setq tm2-linetype-count (1+ tm2-linetype-count)) (setq tm2-record (tblnext "LTYPE")))
(princ (strcat "\nTM2_QC_LINETYPES=" (itoa tm2-linetype-count)))
(setq tm2-xref-count 0 tm2-record (tblnext "BLOCK" T))
(while tm2-record (setq tm2-flags (cdr (assoc 70 tm2-record))) (if (and tm2-flags (/= 0 (logand 4 tm2-flags))) (setq tm2-xref-count (1+ tm2-xref-count))) (setq tm2-record (tblnext "BLOCK")))
(princ (strcat "\nTM2_QC_XREFS=" (itoa tm2-xref-count)))
(princ "\nTM2_QC_END\n")
_.QUIT
_Y
