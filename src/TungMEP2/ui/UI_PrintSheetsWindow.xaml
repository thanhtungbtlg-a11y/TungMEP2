<Window x:Class="VP_RevitAPI.UI.UI_PrintSheetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TungMEP2 - Print Sheets"
        Width="1180"
        Height="960"
        MinWidth="960"
        MinHeight="720"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE6" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5B6573" />
        <SolidColorBrush x:Key="PdfBrush" Color="#1769AA" />
        <SolidColorBrush x:Key="DwgBrush" Color="#008577" />

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#B9C2CD" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,2" />
            <Setter Property="Foreground" Value="#303844" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PathLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7,0,2" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#7B1FA2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#6A1B9A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Xuất bản vẽ hàng loạt"
                           FontSize="23"
                           FontWeight="SemiBold"
                           Foreground="#242A33" />
                <TextBlock Text="Chọn sheet, định dạng và đúng thư mục đầu ra cho từng loại file."
                           Margin="0,3,0,0"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="ToggleSettingsButton"
                        Content="Thu gọn thiết lập"
                        Click="OnToggleSettingsClick"
                        ToolTip="Ẩn/hiện Nguồn, PDF và DWG để dành thêm chiều cao cho danh sách sheet" />
                <Border Padding="12,7"
                        Margin="8,0,0,0"
                        CornerRadius="4"
                        Background="#EEE6F2">
                    <TextBlock x:Name="SourceModeTextBlock"
                               Text="Đang đọc nguồn sheet..."
                               Foreground="#6A1B9A"
                               FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Grid>

        <Border x:Name="SourceControlsPanel"
                Grid.Row="1"
                Width="330"
                Padding="9,7"
                Margin="0,0,10,8"
                HorizontalAlignment="Left"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Nguồn danh sách sheet"
                           Margin="1,0,0,5"
                           FontWeight="SemiBold" />
                <ListBox x:Name="SheetSourcesListBox"
                         Grid.Row="1"
                         Height="190"
                         SelectionMode="Single"
                         SelectionChanged="OnSheetSourcesSelectionChanged"
                         ToolTip="Tích nguồn cần dùng. Chọn một dòng rồi bấm Nhóm lên/xuống để đổi thứ tự PDF giữa các nguồn.">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Checked="OnSheetSourceCheckedChanged"
                                          Unchecked="OnSheetSourceCheckedChanged"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           Margin="6,0,8,0"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        MinWidth="52"
                                        Padding="5,1"
                                        CornerRadius="9"
                                        Background="#EEE6F2">
                                    <TextBlock Text="{Binding OrderBadge}"
                                               HorizontalAlignment="Center"
                                               Foreground="#6A1B9A"
                                               FontSize="10.5"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <UniformGrid Grid.Row="2"
                             Columns="2"
                             Margin="0,5,0,0">
                    <Button Content="Chọn tất cả"
                            Click="OnSelectAllSourcesClick" />
                    <Button Content="Bỏ chọn"
                            Click="OnSelectNoSourcesClick" />
                    <Button Content="↑ Nhóm lên"
                            Click="OnMoveSourceUpClick" />
                    <Button Content="↓ Nhóm xuống"
                            Click="OnMoveSourceDownClick" />
                </UniformGrid>
            </Grid>
        </Border>

        <Grid x:Name="ExportSettingsPanel"
              Grid.Row="1"
              Margin="340,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Padding="9,5,9,8"
                      Background="White"
                      BorderBrush="#8EBBE0"
                      BorderThickness="1.5">
                <GroupBox.Header>
                    <CheckBox x:Name="ExportPdfCheckBox"
                              Content="XUẤT PDF"
                              FontSize="14"
                              FontWeight="Bold"
                              Foreground="{StaticResource PdfBrush}"
                              Checked="OnExportPdfCheckedChanged"
                              Unchecked="OnExportPdfCheckedChanged" />
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Công cụ xuất PDF"
                               Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="PrinterComboBox"
                              Grid.Row="1"
                              DisplayMemberPath="Name"
                              SelectionChanged="OnPrinterSelectionChanged" />

                    <TextBlock x:Name="PdfSetupLabelTextBlock"
                               Grid.Row="2"
                               Text="Chất lượng Native PDF"
                               Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="PdfExportSetupComboBox"
                              Grid.Row="3"
                              DisplayMemberPath="Name" />

                    <TextBlock x:Name="PdfProcessingLabelTextBlock"
                               Grid.Row="4"
                               Text="Xử lý nội dung PDF (Native)"
                               Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="PdfOutputProcessingComboBox"
                              Grid.Row="5"
                              DisplayMemberPath="Name" />

                    <Grid Grid.Row="6" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="CombinePdfCheckBox"
                                  Content="Gộp thành 1 file PDF"
                                  VerticalAlignment="Center"
                                  Checked="OnCombinePdfModeChanged"
                                  Unchecked="OnCombinePdfModeChanged" />
                        <TextBox x:Name="CombinedPdfNameTextBox"
                                 Grid.Column="1"
                                 Margin="12,0,0,0"
                                 ToolTip="Tên file PDF gộp, không cần nhập đuôi .pdf" />
                    </Grid>

                    <TextBlock Grid.Row="7"
                               Text="THƯ MỤC LƯU FILE PDF (.pdf)"
                               Foreground="{StaticResource PdfBrush}"
                               Style="{StaticResource PathLabelStyle}" />
                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputFolderTextBox"
                                 ToolTip="Đây là đường dẫn chỉ dành cho file PDF." />
                        <Button Grid.Column="1"
                                Content="Chọn..."
                                MinWidth="76"
                                Click="OnBrowsePdfOutputFolder"
                                ToolTip="Chọn thư mục lưu PDF" />
                    </Grid>

                    <Border Grid.Row="9"
                            Margin="0,8,0,0"
                            Padding="8,6"
                            Background="#EAF3FA"
                            CornerRadius="3">
                        <TextBlock x:Name="PdfEngineInfoTextBlock"
                                   Text="Native PDF xuất trực tiếp từ Revit, hỗ trợ Vector hoặc Font-safe Raster."
                                   Foreground="#315B78"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      Padding="9,5,9,8"
                      Background="White"
                      BorderBrush="#79C4BB"
                      BorderThickness="1.5">
                <GroupBox.Header>
                    <CheckBox x:Name="ExportDwgCheckBox"
                              Content="XUẤT DWG / CAD"
                              FontSize="14"
                              FontWeight="Bold"
                              Foreground="{StaticResource DwgBrush}"
                              Checked="OnExportDwgCheckedChanged"
                              Unchecked="OnExportDwgCheckedChanged" />
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Revit DWG Export Setup"
                               Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="DwgExportSetupComboBox"
                              Grid.Row="1"
                              DisplayMemberPath="Name" />

                    <TextBlock Grid.Row="2"
                               Text="THƯ MỤC LƯU FILE DWG / CAD (.dwg)"
                               Foreground="{StaticResource DwgBrush}"
                               Style="{StaticResource PathLabelStyle}" />
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DwgOutputFolderTextBox"
                                 ToolTip="Đây là đường dẫn chỉ dành cho file DWG/CAD." />
                        <Button Grid.Column="1"
                                Content="Chọn..."
                                MinWidth="76"
                                Click="OnBrowseDwgOutputFolder"
                                ToolTip="Chọn thư mục lưu DWG/CAD" />
                    </Grid>

                    <Border Grid.Row="4"
                            Margin="0,8,0,0"
                            Padding="8,6"
                            Background="#E6F5F2"
                            CornerRadius="3">
                        <TextBlock Text="Mỗi sheet tạo một DWG riêng tại đường dẫn màu xanh lá phía trên."
                                   Foreground="#23675F"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </GroupBox>
        </Grid>

        <Border x:Name="SheetListControlsPanel"
                Grid.Row="3"
                Margin="0,0,0,7"
                Padding="10,8"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="DANH SÁCH SHEET SẼ XUẤT — THEO NHÓM NGUỒN"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="#303844" />
                    <Button Grid.Column="1"
                            Content="↑ Sheet"
                            Click="OnMoveSheetUpClick"
                            ToolTip="Di chuyển sheet lên trong chính nhóm nguồn của nó" />
                    <Button Grid.Column="2"
                            Content="↓ Sheet"
                            Click="OnMoveSheetDownClick"
                            ToolTip="Di chuyển sheet xuống trong chính nhóm nguồn của nó" />
                    <Button Grid.Column="3"
                            Content="Chọn tất cả"
                            Click="OnSelectAllSheetsClick" />
                    <Button Grid.Column="4"
                            Content="Bỏ chọn"
                            Click="OnSelectNoSheetsClick" />
                </Grid>

                <Grid x:Name="SttControlsPanel" Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="STT bắt đầu"
                               VerticalAlignment="Center"
                               Foreground="#303844"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="SttStartTextBox"
                             Grid.Column="1"
                             Text="1"
                             Margin="7,0,0,0"
                             HorizontalContentAlignment="Center" />
                    <Button Grid.Column="2"
                            Content="Tạo STT theo thứ tự PDF"
                            Click="OnGenerateSttClick"
                            ToolTip="Tạo STT nháp cho các sheet đang tích theo đúng thứ tự PDF hiển thị" />
                    <Button Grid.Column="3"
                            Content="Ghi STT vào Sheet"
                            Click="OnApplySttClick"
                            ToolTip="Ghi các giá trị trong cột STT vào parameter STT của Revit" />
                    <TextBlock x:Name="SttStatusTextBlock"
                               Grid.Column="4"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Có thể sửa trực tiếp cột STT; chỉ ghi vào Revit khi bấm Ghi STT."
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <DataGrid x:Name="SheetsDataGrid"
                      MinHeight="320"
                      FontSize="11"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E7EBF0"
                      RowHeaderWidth="0"
                      RowHeight="23"
                      ColumnHeaderHeight="27"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      AlternatingRowBackground="#F7F9FB">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Padding="8,3"
                                        Margin="0,2,0,1"
                                        Background="#EEE6F2"
                                        BorderBrush="#D5C2DF"
                                        BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#6A1B9A"
                                               FontSize="11"
                                               FontWeight="Bold" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Xuất" Width="54">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Checked="OnSheetExportSelectionChanged"
                                          Unchecked="OnSheetExportSelectionChanged"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PDF #"
                                        Width="58"
                                        IsReadOnly="True"
                                        Binding="{Binding ExportOrderText}" />
                    <DataGridTemplateColumn Header="Nguồn sheet" Width="155">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SourceDisplay}"
                                           ToolTip="{Binding SourceDetails}"
                                           Margin="4,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Số hiệu sheet"
                                        Width="135"
                                        IsReadOnly="True"
                                        Binding="{Binding SheetNumber}" />
                    <DataGridTextColumn Header="Tên sheet"
                                        Width="*"
                                        IsReadOnly="True"
                                        Binding="{Binding SheetName}" />
                    <DataGridTextColumn Header="STT"
                                        Width="72"
                                        Binding="{Binding ProposedStt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Thứ tự PDF lấy đúng theo số PDF #. Export không tự ý thay đổi parameter STT."
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11" />
            <Button Grid.Column="1"
                    Content="Đổi tên PDF cũ"
                    Click="OnChangePdfNameClick"
                    ToolTip="Đổi tên các file PDF legacy có chuỗi ' - Sheet - '" />
            <Button x:Name="ExportButton"
                    Grid.Column="2"
                    Content="Bắt đầu xuất"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnExportClick" />
            <Button x:Name="CloseButton"
                    Grid.Column="3"
                    Content="Đóng"
                    MinWidth="82"
                    Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
